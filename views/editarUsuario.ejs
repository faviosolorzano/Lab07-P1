<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Editar usuario
    </title>

    <link
        rel="stylesheet"
        href="/css/styles.css"
    >

</head>

<body
    class="app-body"
    style="--server-color: <%= color %>;"
>

    <header class="navbar">

        <div>

            <strong>
                LAB 07
            </strong>

            <span>
                Editar usuario
            </span>

        </div>

        <div class="navbar-user">

            <span>
                <%= servidor %>
            </span>

            <a href="/usuarios">
                Volver
            </a>

        </div>

    </header>


    <main class="form-page">

        <section class="form-card">

            <p class="eyebrow">
                EDITAR
            </p>

            <h1>
                Modificar usuario
            </h1>

            <p class="form-description">
                Actualiza la información del usuario seleccionado.
            </p>


            <form
                action="/usuarios/editar/<%= usuarioEditar.id %>"
                method="POST"
            >

                <div class="form-group">

                    <label>
                        Nombre completo
                    </label>

                    <input
                        type="text"
                        name="nombre"
                        value="<%= usuarioEditar.nombre %>"
                        required
                    >

                </div>


                <div class="form-group">

                    <label>
                        Correo electrónico
                    </label>

                    <input
                        type="email"
                        name="email"
                        value="<%= usuarioEditar.email %>"
                        required
                    >

                </div>


                <div class="form-group">

                    <label>
                        Rol
                    </label>

                    <select
                        name="rol"
                        required
                    >

                        <option
                            value="Usuario"
                            <%= usuarioEditar.rol === "Usuario" ? "selected" : "" %>
                        >
                            Usuario
                        </option>

                        <option
                            value="Administrador"
                            <%= usuarioEditar.rol === "Administrador" ? "selected" : "" %>
                        >
                            Administrador
                        </option>

                    </select>

                </div>


                <div class="form-buttons">

                    <a
                        href="/usuarios"
                        class="secondary-link"
                    >
                        Cancelar
                    </a>

                    <button
                        type="submit"
                        class="save-btn"
                    >
                        Guardar cambios
                    </button>

                </div>

            </form>

        </section>

    </main>

</body>

</html>